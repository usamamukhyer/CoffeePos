<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DBCafeteria.Controls"
             x:Class="DBCafeteria.Views.SignupPage"
             BackgroundColor="{StaticResource CoffeeBackground}">
    <Grid BackgroundColor="{StaticResource CoffeeBackground}">
        <ScrollView BackgroundColor="{StaticResource CoffeeBackground}">
            <VerticalStackLayout Padding="24,16,24,32" Spacing="16">
                <Grid ColumnDefinitions="36,*">
                    <Label Text="‹" TextColor="{StaticResource GoldPrimary}" FontSize="34" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="1" Text="Crear cuenta" Style="{StaticResource HeaderLabel}" />
                </Grid>

                <VerticalStackLayout Spacing="8" Margin="0,24,0,14">
                    <Label Text="CAFE" TextColor="{StaticResource GoldPrimary}" FontSize="14" CharacterSpacing="5" HorizontalTextAlignment="Center" />
                    <Label Text="UNETE AL CLUB" Style="{StaticResource HeroLabel}" FontSize="23" />
                    <Label Text="Crea una cuenta para guardar tus pedidos." TextColor="{StaticResource MutedText}" FontSize="13" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Label Text="NOMBRE COMPLETO" Style="{StaticResource SectionLabel}" />
                <Border Stroke="{StaticResource DimBorder}" Padding="12,0" BackgroundColor="{StaticResource CoffeeSurface}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Entry Placeholder="Tu nombre" Text="{Binding FullName}" />
                </Border>

                <Label Text="EMAIL" Style="{StaticResource SectionLabel}" />
                <Border Stroke="{StaticResource DimBorder}" Padding="12,0" BackgroundColor="{StaticResource CoffeeSurface}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Entry Placeholder="Correo electronico" Keyboard="Email" Text="{Binding Email}" />
                </Border>

                <Label Text="TELEFONO" Style="{StaticResource SectionLabel}" />
                <Border Stroke="{StaticResource DimBorder}" Padding="12,0" BackgroundColor="{StaticResource CoffeeSurface}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Entry Placeholder="+1..." Keyboard="Telephone" Text="{Binding PhoneNumber}" />
                </Border>

                <Label Text="CONTRASENA" Style="{StaticResource SectionLabel}" />
                <Border Stroke="{StaticResource DimBorder}" Padding="12,0" BackgroundColor="{StaticResource CoffeeSurface}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Entry Placeholder="Contrasena" IsPassword="True" Text="{Binding Password}" />
                </Border>

                <Label Text="CONFIRMAR CONTRASENA" Style="{StaticResource SectionLabel}" />
                <Border Stroke="{StaticResource DimBorder}" Padding="12,0" BackgroundColor="{StaticResource CoffeeSurface}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <Entry Placeholder="Confirmar contrasena" IsPassword="True" Text="{Binding ConfirmPassword}" />
                </Border>

                <Label Text="{Binding ValidationMessage}" Style="{StaticResource ValidationMessageStyle}" IsVisible="{Binding HasValidationMessage}" />

                <controls:GoldButton Text="CREAR CUENTA" Command="{Binding CreateAccountCommand}" Margin="0,8,0,0" />

                <Label Text="Ya tienes cuenta? Inicia sesion" Style="{StaticResource LinkTextStyle}" Margin="0,8,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Continuar como invitado" Style="{StaticResource LinkTextStyle}" TextColor="{StaticResource MutedText}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GuestCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
