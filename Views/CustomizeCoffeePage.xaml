<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DBCafeteria.Controls"
             x:Name="Page"
             x:Class="DBCafeteria.Views.CustomizeCoffeePage"
             BackgroundColor="{StaticResource CoffeeBackground}">
    <Grid RowDefinitions="*,Auto,Auto" BackgroundColor="{StaticResource CoffeeBackground}">
        <ScrollView Grid.Row="0" BackgroundColor="{StaticResource CoffeeBackground}">
            <VerticalStackLayout Padding="16,14,16,18" Spacing="18">
                <Grid ColumnDefinitions="40,*">
                    <Label Text="&lt;" TextColor="{StaticResource GoldPrimary}" FontSize="30" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding BackCommand}" /></Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="1" Text="Personaliza tu cafe" Style="{StaticResource HeaderLabel}" />
                </Grid>
                <Label Text="{Binding ProductName}" FontSize="21" FontAttributes="Bold" Margin="0,8,0,0" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,8,0,0" Color="{StaticResource GoldPrimary}" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageStyle}" IsVisible="{Binding HasError}" Margin="0,4,0,0" />
                <controls:SectionTitle Text="TEMPERATURA" />
                <CollectionView ItemsSource="{Binding Temperatures}" SelectionMode="None" HeightRequest="58">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate><DataTemplate><Border Padding="22,12" Stroke="{StaticResource DimBorder}" BackgroundColor="{StaticResource CoffeeSurface}"><Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="Stroke" Value="{StaticResource GoldPrimary}" /></DataTrigger></Border.Triggers><Label Text="{Binding Title}" FontAttributes="Bold" /><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding BindingContext.SelectTemperatureCommand, Source={x:Reference Page}}" CommandParameter="{Binding Title}" /></Border.GestureRecognizers></Border></DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
                <controls:SectionTitle Text="TIPO DE GRANO" />
                <CollectionView ItemsSource="{Binding Beans}" SelectionMode="None" HeightRequest="58">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate><DataTemplate><Border Padding="14,12" Stroke="{StaticResource DimBorder}" BackgroundColor="{StaticResource CoffeeSurface}"><Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="Stroke" Value="{StaticResource GoldPrimary}" /></DataTrigger></Border.Triggers><Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" /><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding BindingContext.SelectBeanCommand, Source={x:Reference Page}}" CommandParameter="{Binding Title}" /></Border.GestureRecognizers></Border></DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
                <controls:SectionTitle Text="TAMANO" />
                <CollectionView ItemsSource="{Binding Sizes}" SelectionMode="None" HeightRequest="58">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate><DataTemplate><Border Padding="22,12" Stroke="{StaticResource DimBorder}" BackgroundColor="{StaticResource CoffeeSurface}"><Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="Stroke" Value="{StaticResource GoldPrimary}" /></DataTrigger></Border.Triggers><Label Text="{Binding Title}" FontAttributes="Bold" /><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding BindingContext.SelectSizeCommand, Source={x:Reference Page}}" CommandParameter="{Binding Title}" /></Border.GestureRecognizers></Border></DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
                <controls:SectionTitle Text="OPCIONES DE LECHE" />
                <CollectionView ItemsSource="{Binding MilkOptions}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14" Stroke="{StaticResource DimBorder}" BackgroundColor="{StaticResource CoffeeSurface}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                                <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="Stroke" Value="{StaticResource GoldPrimary}" /><Setter Property="BackgroundColor" Value="#3A2511" /></DataTrigger></Border.Triggers>
                                <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding Title}" FontAttributes="Bold" FontSize="13" /><Label Grid.Column="1" Text="{Binding Detail}" TextColor="{StaticResource GoldPrimary}" /></Grid>
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding BindingContext.SelectMilkCommand, Source={x:Reference Page}}" CommandParameter="{Binding Title}" /></Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <controls:SectionTitle Text="ADICIONES / TOPPINGS" />
                <CollectionView ItemsSource="{Binding Toppings}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,4,0,10" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding Detail}" TextColor="{StaticResource MutedText}" FontSize="12" />
                                </VerticalStackLayout>
                                <controls:QuantityStepper Grid.Column="1" Quantity="{Binding Quantity}" IncrementCommand="{Binding BindingContext.IncrementToppingCommand, Source={x:Reference Page}}" DecrementCommand="{Binding BindingContext.DecrementToppingCommand, Source={x:Reference Page}}" CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" Padding="14,12" BackgroundColor="{StaticResource CoffeeSurface}" ColumnDefinitions="*,150">
            <VerticalStackLayout><Label Text="TOTAL" TextColor="{StaticResource MutedText}" FontSize="11" /><Label Text="{Binding TotalAmountText}" FontSize="23" FontAttributes="Bold" /></VerticalStackLayout>
            <controls:GoldButton Grid.Column="1" Text="AGREGAR" Command="{Binding AddToBasketCommand}" />
        </Grid>
        <controls:BottomNavigationBar Grid.Row="2" ActiveTab="Menu" />
    </Grid>
</ContentPage>
