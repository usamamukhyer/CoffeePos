<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DBCafeteria.Controls"
             x:Name="Page"
             x:Class="DBCafeteria.Views.ShopByCategoryPage"
             BackgroundColor="{StaticResource CoffeeBackground}">
    <Grid RowDefinitions="*,Auto" BackgroundColor="{StaticResource CoffeeBackground}">
        <VerticalStackLayout Grid.Row="0" Spacing="0">
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,10,0,0" Color="{StaticResource GoldPrimary}" />
        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageStyle}" IsVisible="{Binding HasError}" Margin="12,8" />
        <Label Text="No categories are available." TextColor="{StaticResource MutedText}" IsVisible="{Binding IsEmpty}" HorizontalTextAlignment="Center" Margin="12,28" />
        <CollectionView ItemsSource="{Binding Categories}" Margin="6,0" SelectionMode="None">
            <CollectionView.Header>
                <Label Text="Shop by Category" Style="{StaticResource HeaderLabel}" Margin="6,14,0,10" />
            </CollectionView.Header>
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="28" VerticalItemSpacing="28" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#1C1613" StrokeThickness="1" BackgroundColor="#0B0908" HeightRequest="136">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid>
                            <Image Source="{Binding Image}" Aspect="AspectFill" />
                            <BoxView Color="#AA8A8A8A" VerticalOptions="End" HeightRequest="36" />
                            <Label Text="{Binding Name}" VerticalOptions="End" HorizontalTextAlignment="Center" FontAttributes="Bold" FontSize="16" Margin="0,0,0,8" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference Page}}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </VerticalStackLayout>
        <controls:BottomNavigationBar Grid.Row="1" ActiveTab="Menu" />
    </Grid>
</ContentPage>
