<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DBCafeteria.Controls"
             x:Name="Page"
             x:Class="DBCafeteria.Views.OurMenuPage"
             BackgroundColor="{StaticResource CoffeeBackground}">
    <Grid RowDefinitions="*,Auto" BackgroundColor="{StaticResource CoffeeBackground}">
        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <Grid ColumnDefinitions="40,*" Padding="8,14,8,14" BackgroundColor="{StaticResource CoffeeHeader}">
                <Label Text="‹" TextColor="{StaticResource GoldPrimary}" FontSize="34" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding BackCommand}" /></Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="Our Menu" Style="{StaticResource HeaderLabel}" />
            </Grid>
            <Label Text="SUB-CATEGORIES" TextColor="{StaticResource GoldPrimary}" FontAttributes="Bold" FontSize="12" CharacterSpacing="1.2" Padding="10,10" BackgroundColor="{StaticResource CoffeeSurface}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,10,0,0" Color="{StaticResource GoldPrimary}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageStyle}" IsVisible="{Binding HasError}" Margin="12,8" />
            <Label Text="No sub-categories are available." TextColor="{StaticResource MutedText}" IsVisible="{Binding IsEmpty}" HorizontalTextAlignment="Center" Margin="12,28" />
            <CollectionView ItemsSource="{Binding Products}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6,14,28,10" ColumnDefinitions="78,*,28" RowDefinitions="Auto,1">
                            <Border WidthRequest="76" HeightRequest="76" Stroke="{StaticResource DimBorder}" BackgroundColor="{StaticResource CoffeeSurface}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Image Source="{Binding Image}" Aspect="AspectFit" Margin="9" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" Margin="18,0,0,0">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Label Text="{Binding Subtitle}" TextColor="{StaticResource MutedText}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#4E3830" FontSize="34" VerticalOptions="Center" />
                            <BoxView Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HeightRequest="1" Color="#251814" Margin="0,12,0,0" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.SelectProductCommand, Source={x:Reference Page}}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        <controls:BottomNavigationBar Grid.Row="1" ActiveTab="Menu" />
    </Grid>
</ContentPage>
