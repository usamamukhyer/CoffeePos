<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DBCafeteria.Controls"
             x:Class="DBCafeteria.Views.OrderSuccessPage"
             BackgroundColor="{StaticResource CoffeeBackground}">
    <Grid Padding="32" RowDefinitions="*,Auto,Auto,Auto,*" RowSpacing="24" BackgroundColor="{StaticResource CoffeeBackground}">
        <Border Grid.Row="1" WidthRequest="96" HeightRequest="96" Stroke="{StaticResource GoldPrimary}" BackgroundColor="{StaticResource CoffeeSurface}" HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="48" />
            </Border.StrokeShape>
            <Label Text="OK" TextColor="{StaticResource GoldPrimary}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>
        <Label Grid.Row="2" Text="Your order has been placed successfully." FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
        <controls:GoldButton Grid.Row="3" Text="Back to Home" Command="{Binding BackHomeCommand}" />
    </Grid>
</ContentPage>
