<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DBCafeteria.Controls"
             x:Class="DBCafeteria.Views.AuthLandingPage"
             BackgroundColor="{StaticResource CoffeeBackground}">
    <Grid Padding="44,0"
          RowDefinitions="*,Auto,Auto,Auto,Auto,Auto,*"
          RowSpacing="24"
          BackgroundColor="{StaticResource CoffeeBackground}">
        <Label Grid.Row="1" Text="LOGIN / GUEST" Style="{StaticResource AuthTitleStyle}" />
        <controls:GoldButton Grid.Row="2" Text="Login / Registered" Command="{Binding LoginCommand}" />
        <controls:GoldButton Grid.Row="3" Text="Create Account / Sign Up" Command="{Binding SignupCommand}" />
        <controls:GoldButton Grid.Row="4" Text="Continue as Guest" Command="{Binding GuestCommand}" />
        <BoxView Grid.Row="5" HeightRequest="1" BackgroundColor="#46342C" Margin="0,28,0,24" />
        <Label Grid.Row="6"
               Text="Login to access seasonal loyalty"
               FontSize="14"
               TextColor="{StaticResource TextWhite}"
               HorizontalTextAlignment="Center"
               VerticalOptions="Start" />
    </Grid>
</ContentPage>
