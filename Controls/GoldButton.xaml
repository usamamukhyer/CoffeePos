<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DBCafeteria.Controls.GoldButton"
             x:Name="Root">
    <Button Text="{Binding Text, Source={x:Reference Root}}"
            Command="{Binding Command, Source={x:Reference Root}}"
            CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}"
            HeightRequest="56"
            CornerRadius="15"
            BackgroundColor="{StaticResource GoldPrimary}"
            TextColor="#1D140A"
            FontFamily="OpenSansSemibold"
            FontSize="14" />
</ContentView>
