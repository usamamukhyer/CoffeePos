<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DBCafeteria.Controls.ProductCard"
             x:Name="Root">
    <Border Stroke="{StaticResource DimBorder}" BackgroundColor="{StaticResource CoffeeSurface}" Padding="12">
        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="14">
            <Image Source="{Binding Image, Source={x:Reference Root}}" WidthRequest="58" HeightRequest="58" Aspect="AspectFit" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding Title, Source={x:Reference Root}}" FontAttributes="Bold" FontSize="16" />
                <Label Text="{Binding Subtitle, Source={x:Reference Root}}" TextColor="{StaticResource MutedText}" FontSize="12" />
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="›" TextColor="{StaticResource GoldPrimary}" FontSize="30" VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
